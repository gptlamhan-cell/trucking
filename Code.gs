').replaceChildren(new Option('Đang tìm tuyến…',''));button.disabled=true;el('hint').textContent='Đang đo khoảng cách đường bộ…';google.script.run.withFailureHandler(e=>{button.disabled=false;if(request===seq&&query===el('a').value.trim())el('hint').textContent=e.message;}).withSuccessHandler(x=>{button.disabled=false;if(request!==seq||query!==el('a').value.trim())return;el('hint').textContent=x.message;el('r').replaceChildren(new Option(x.routes.length?'Chọn tuyến tham khảo':'Chưa có tuyến theo bản đồ',''),...x.routes.map(r=>new Option(r.name+' · '+r.km+' km đường bộ · tham khảo',r.id)));}).nearbyRoutes(el('h').value,el('m').value,el('c').value,query);};load();</script></html>`).setTitle('Tính cước trucking');}
function data_(hub){const cfg={HAN:[5,10],HPH:[4,12],HCM:[4,7]}[hub];if(!Array.isArray(cfg))throw Error('Đầu tuyến không hợp lệ');const sh=SpreadsheetApp.openById(DB).getSheetByName(hub);const rows=sh.getRange(1,1,sh.getLastRow(),cfg[1]).getValues();const keys=rows[1].slice(2).map(v=>{const n=String(v).match(/\d+(?:[.,]\d+)?/);return n?(Number(n[0])===20||Number(n[0])===40?'C':'')+n[0].replace(',','.'):''});return {rows,keys,first:cfg[0]};}
function catalog(hub,mode,container){const {rows,keys,first}=data_(hub);const routes=[];let province='';rows.forEach((r,i)=>{if(i+1<first)return;province=r[0]||province;if(r[1]&&keys.some((k,j)=>(mode==='FCL'?k===container:k&&!k.startsWith('C'))&&typeof r[j+2]==='number'&&r[j+2]>0))routes.push([i+1,province+' · '+r[1]]);});return {routes,types:keys.filter(k=>k&&!k.startsWith('C'))};}
function price(hub,row,key,count,fsc){const {rows,keys,first}=data_(hub);const col=keys.indexOf(key);if(!Number.isInteger(row)||row<first||row>rows.length||col<0||!Number.isSafeInteger(count)||count<1||count>500||!Number.isFinite(fsc)||fsc<0)throw Error('Kiểm tra thông tin báo giá');const base=rows[row-1][col+2];if(typeof base!=='number'||base<=0)throw Error('Cần hỏi giá cho tuyến và phương tiện này');const applied=fsc*(hub==='HPH'?1.75:1);return {total:Math.round(base*count*(1+applied/100)),fsc:applied};}
function lookupAddress(hub,mode,container,query){
 const normalize=s=>String(s||'').toLowerCase().replace(/đ/g,'d').normalize('NFD').replace(/[\u0300-\u036f]/g,'').replace(/[^a-z0-9]+/g,' ').replace(/\btp\b/g,'thanh pho').trim();
 const has=(text,part)=>part&&(' '+text+' ').includes(' '+part+' ');
 const q=normalize(String(query).slice(0,500));
 const table=SpreadsheetApp.openById(DB).getSheetByName('Xã cũ - mới');
 const routes=catalog(hub,mode,container).routes;
 const scores=new Map();
 function rank(predicate,score){for(const row of routes)if(predicate(normalize(row[1])))scores.set(row,Math.max(score,scores.get(row)||0));}
 if(hub==='HCM'&&has(q,'phuong vinh tan')&&has(q,'ho chi minh'))rank(name=>has(name,'nam tan uyen')&&has(name,'binh duong'),100);
 const entries=table.getRange(2,1,table.getLastRow()-1,10).getDisplayValues();
 for(const row of entries){
  const [oldProvince,district,oldWard,newProvince,newWard]=[1,3,5,7,9].map(i=>normalize(row[i]));
  const bare=s=>s.replace(/^(thanh pho|tinh|quan|huyen|thi xa|thi tran|phuong|xa|dac khu) /,'');
  if(!has(q,newWard)||!has(q,bare(newProvince)))continue;
  const p=bare(oldProvince),d=bare(district),w=bare(oldWard);
  if(w.length>3)rank(name=>has(name,p)&&has(name,w),80);
  if(d.length>3)rank(name=>has(name,p)&&has(name,d),55);
 }
 return [...scores].sort((a,b)=>b[1]-a[1]).slice(0,8).map(([row])=>row);
}

function nearbyRoutes(hub,mode,container,query){
 const q=String(query||'').trim().slice(0,500);
 if(!q)throw Error('Nhập địa chỉ hoặc tọa độ.');
 const candidates=catalog(hub,mode,container).routes;
 const refs=[['Nam Tân Uyên mở rộng','Khu công nghiệp Nam Tân Uyên mở rộng, Vĩnh Tân, Bình Dương, Việt Nam'],['KCN Đất Cuốc','Khu công nghiệp Đất Cuốc, Bắc Tân Uyên, Bình Dương, Việt Nam'],['Nam Tân Uyên mở rộng','Khu công nghiệp Nam Tân Uyên, Tân Uyên, Bình Dương, Việt Nam']];
 const sheet=SpreadsheetApp.openById(DB).getSheetByName('Điểm tham chiếu');
 const points=sheet&&sheet.getLastRow()>1?sheet.getRange(2,1,sheet.getLastRow()-1,3).getDisplayValues().filter(r=>r[0]===hub).map(r=>r.slice(1)):[];
 if(hub==='HCM')points.push(...refs);if(hub==='HPH')points.push(['Bình Giang, Cẩm Giàng','Cẩm Giàng, Hải Dương, Việt Nam'],['KCN Đại An','Khu công nghiệp Đại An, Hải Dương, Việt Nam'],['Kim Thành, Phú Thái','Phú Thái, Kim Thành, Hải Phòng, Việt Nam'],['Uông Bí, Đông Triều','Đông Triều, Quảng Ninh, Việt Nam']);
 const eligible=points.flatMap(([name,address])=>name&&address?candidates.filter(r=>r[1].toLowerCase().includes(name.toLowerCase())).map(([id,label])=>({id,label,address})):[]);
 if(hub==='HPH'&&/^kinh m[oô]n$/i.test(q))eligible.sort((a,b)=>Number(b.label.includes('Kim Thành'))-Number(a.label.includes('Kim Thành')));
 if(!eligible.length)return {routes:[],message:'Cần hỏi giá. Chưa có điểm tham chiếu bản đồ cho lựa chọn này.'};
 const coords=q.match(/^(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)$/);
 let origin=coords?{lat:Number(coords[1]),lng:Number(coords[2])}:null;
 if(origin&&(Math.abs(origin.lat)>90||Math.abs(origin.lng)>180))throw Error('Tọa độ không hợp lệ.');
 let resolved='Tọa độ đã nhập';
 if(!origin){
  const results=Maps.newGeocoder().setRegion('vn').geocode(/^kinh m[oô]n$/i.test(q)?'Kinh Môn, Hải Phòng, Việt Nam':q).results||[];
  const match=results[0];
  if(!match||match.partial_match||(!['ROOFTOP','RANGE_INTERPOLATED'].includes(match.geometry.location_type)&&q.includes(',')))return {routes:[],message:'Maps chưa xác định đủ chính xác điểm giao. Dán tọa độ từ ghim Google Maps để đo đường bộ.'};
  origin=match.geometry.location;resolved=match.formatted_address+(match.geometry.location_type==='ROOFTOP'?'':' (vị trí ước tính)');
 }
 const ranked=new Map();
 for(const point of eligible.slice(0,12)){
  const result=Maps.newDirectionFinder().setOrigin(origin.lat,origin.lng).setDestination(point.address).setRegion('vn').setMode(Maps.DirectionFinder.Mode.DRIVING).getDirections();
  const meters=result.routes?.[0]?.legs?.[0]?.distance?.value;
  if(typeof meters!=='number'||meters>30000)continue;
  if(!ranked.has(point.id)||meters<ranked.get(point.id).meters)ranked.set(point.id,{id:point.id,name:point.label,meters,km:Math.round(meters/100)/10});
 }
 const routes=[...ranked.values()].sort((a,b)=>a.meters-b.meters).slice(0,3);
 return {routes,message:routes.length?resolved+' · Chọn tuyến tham khảo. Khoảng cách theo đường ô tô.':'Cần hỏi giá. Không tìm thấy điểm tham chiếu trong 30 km đường bộ.'};
}

function quoteCargo(hub,row,key,count,fsc,dimensions,kg){
 if(key!=='LCL'){const quote=price(hub,row,key,count,fsc);quote.total=Math.round(quote.total/100000)*100000;return quote;}
 const match=String(dimensions).trim().match(/^(\d+(?:[.,]\d+)?)\s*[x×*]\s*(\d+(?:[.,]\d+)?)\s*[x×*]\s*(\d+(?:[.,]\d+)?)$/i);
 if(!match||!Number.isFinite(kg)||kg<=0||!Number.isInteger(count)||count<1||count>500)throw Error('Nhập kích thước D×R×C, trọng lượng mỗi kiện và số kiện.');
 const [l,w,h]=match.slice(1).map(v=>Number(v.replace(',','.')));
 if(Math.min(l,w,h)<=0)throw Error('Kích thước phải lớn hơn 0.');
 const specs={'1':[310,155,155,1000],'1.25':[300,160,160,1000],'1.45':[350,160,160,1400],'2':[410,170,170,2000],'2.5':[420,175,180,2200],'3.5':[480,200,200,3300],'5':[570,195,195,4800],'7':[670,230,230,6000],'8':[690,230,220,7500],'9':[730,230,230,8500],'10':[820,230,230,9000],'15':[960,235,250,15000]};
 const {rows,keys,first}=data_(hub);
 if(!Number.isInteger(row)||row<first||row>rows.length)throw Error('Chọn tuyến đối chiếu.');
 const options=[];
 keys.forEach((type,i)=>{
  const spec=specs[type],rate=rows[row-1][i+2];if(!spec||typeof rate!=='number'||rate<=0)return;
  const [L,W,H,K]=spec;if(h>H)return;
  const per=Math.min(Math.floor(K/kg),Math.max(Math.floor(L/l)*Math.floor(W/w),Math.floor(L/w)*Math.floor(W/l)));
  if(per<1)return;
  const trucks=Math.ceil(count/per);options.push({type,trucks,cost:trucks*rate});
 });
 options.sort((a,b)=>a.cost-b.cost||a.trucks-b.trucks);
 if(!options.length)throw Error('Kiện vượt tải hoặc kích thước xe có giá trên tuyến.');
 const {type,trucks}=options[0];const quote=price(hub,row,type,trucks,fsc);
 return {...quote,total:Math.round(quote.total/100000)*100000,vehicle:trucks+' xe '+type+' tấn (xếp một lớp)'};
}

const SUNREIGN_PNG = "";
function dinhViToanBo() {
 const sheet=SpreadsheetApp.openById(DB).getSheetByName('Điểm tham chiếu');
 const lock=LockService.getScriptLock(); lock.waitLock(10000);
 try {
 const n=sheet.getLastRow();
 if(sheet.getRange('A1').getDisplayValue().includes('\t')){
  const data=sheet.getRange(1,1,n,1).getDisplayValues().map(r=>r[0].split('\t'));
  if(data.some(r=>r.length!==10))throw Error('Dữ liệu TSV không đủ 10 cột');
  sheet.getRange(1,1,n,10).setValues(data);
  sheet.setFrozenRows(1);
 }
 const rows=sheet.getRange(2,1,n-1,10).getValues();
 const cache=new Map();
 for(const row of rows)if(row[5]==='Có tọa độ')cache.set(row[2],row.slice(3,7));
 const geo=Maps.newGeocoder().setRegion('vn').setLanguage('vi');
 const deadline=Date.now()+240000;
 for(const [i,row] of rows.entries()){
  if(Date.now()>deadline)break;
  if(row[5]!=='Chờ định vị')continue;
  let value=cache.get(row[2]);
  if(!value){
   const r=geo.geocode(String(row[2]));
   if(!['OK','ZERO_RESULTS'].includes(r.status))break;
   const m=r.results?.[0]; const p=m?.geometry?.location;
   const valid=p&&m.address_components?.some(c=>c.types.includes('country')&&c.short_name==='VN');
   value=valid?[p.lat,p.lng,(m.partial_match||r.results.length>1)?'Cần rà tọa độ':'Có tọa độ',m.formatted_address]:['','','Cần xác định điểm',''];
   cache.set(row[2],value);
  }
  sheet.getRange(i+2,4,1,4).setValues([value]);
 }
 SpreadsheetApp.flush();
 console.log(JSON.stringify(sheet.getRange(2,6,n-1,1).getValues().flat().reduce((a,s)=>(a[s]=(a[s]||0)+1,a),{})));
 }finally{lock.releaseLock();}
}


function dinhViToanBo() {
 const sheet=SpreadsheetApp.openById(DB).getSheetByName('Điểm tham chiếu');
 const lock=LockService.getScriptLock(); lock.waitLock(10000);
 try {
 const n=sheet.getLastRow();

 const rows=sheet.getRange(2,1,n-1,10).getValues();
 const cache=new Map();
 for(const row of rows)if(row[5]==='Có tọa độ')cache.set(row[2],row.slice(3,7));
 const geo=Maps.newGeocoder().setRegion('vn').setLanguage('vi');
 const deadline=Date.now()+240000;
 for(const [i,row] of rows.entries()){
  if(Date.now()>deadline)break;
  if(row[5]!=='Chờ định vị')continue;
  let value=cache.get(row[2]);
  if(!value){
   Utilities.sleep(1100);
   const r=geo.geocode(String(row[2]));
   if(!['OK','ZERO_RESULTS'].includes(r.status)){console.log(r.status);break;}
   const m=r.results?.[0]; const p=m?.geometry?.location;
   const valid=p&&m.address_components?.some(c=>c.types.includes('country')&&c.short_name==='VN');
   value=valid?[p.lat,p.lng,(m.partial_match||r.results.length>1)?'Cần rà tọa độ':'Có tọa độ',m.formatted_address]:['','','Cần xác định điểm',''];
   cache.set(row[2],value);
  }
  sheet.getRange(i+2,4,1,4).setValues([value]);
 }
 SpreadsheetApp.flush();
 console.log(JSON.stringify(sheet.getRange(2,6,n-1,1).getValues().flat().reduce((a,s)=>(a[s]=(a[s]||0)+1,a),{})));
 }finally{lock.releaseLock();}
}

function nearbyRoutes(hub, mode, container, query) {
 const routes = catalog(hub, mode, container).routes;
 const sheet = SpreadsheetApp.openById(DB).getSheetByName('Điểm tham chiếu');
 const q = String(query || '').trim().slice(0, 500);
 if (!q || !sheet || sheet.getLastRow() < 2) return {routes: [], message: 'Chưa có điểm tham chiếu.'};
 const coords = q.match(/^(-?\d+(?:\.\d+)?)\s*,\s*(-?\d+(?:\.\d+)?)$/);
 const response = coords ? null : Maps.newGeocoder().setRegion('vn').geocode(q + ', Việt Nam');
 const location = response?.results?.[0];
 const origin = coords ? {lat:Number(coords[1]),lng:Number(coords[2])} : location?.geometry?.location;
 if (!origin || Math.abs(origin.lat)>90 || Math.abs(origin.lng)>180 || (!coords && response.results.length!==1)) return {routes:[],message:'Chưa xác định được một vị trí. Nhập thêm địa phương hoặc tọa độ.'};
 const matches = new Map(routes.map(([id,label])=>[label,{id,label}]));
 const points = [];
 for (const [head, name, address, lat, lng, status, formatted, province] of sheet.getRange(2,1,sheet.getLastRow()-1,8).getValues()) {
  const route = matches.get(province+' · '+name);
  if(head!==hub || !route || status!=='Có tọa độ' || !Number.isFinite(lat) || !Number.isFinite(lng))continue;
  const rad=Math.PI/180;
  const a=Math.sin((lat-origin.lat)*rad/2)**2+Math.cos(lat*rad)*Math.cos(origin.lat*rad)*Math.sin((lng-origin.lng)*rad/2)**2;
  const direct=12742*Math.asin(Math.sqrt(Math.min(1,a)));
  if(direct<=30)points.push({...route,lat,lng,direct});
 }
 const found=new Map();
 for(const point of points.sort((a,b)=>a.direct-b.direct).slice(0,15)){
  const reply=Maps.newDirectionFinder().setOrigin(origin.lat,origin.lng).setDestination(point.lat,point.lng).setMode(Maps.DirectionFinder.Mode.DRIVING).getDirections();
  const meters=reply.routes?.[0]?.legs?.[0]?.distance?.value;
  if(typeof meters==='number'&&meters<=30000&&meters<(found.get(point.id)?.meters??Infinity))found.set(point.id,{id:point.id,name:point.label,meters,km:Math.round(meters/100)/10});
 }
 const result=[...found.values()].sort((a,b)=>a.meters-b.meters).slice(0,3);
 return {routes:result,message:(location?.formatted_address||'Tọa độ đã nhập')+(location?.geometry?.location_type==='ROOFTOP'||coords?'':' (vị trí ước tính)')+(result.length?' · Chọn tuyến tham khảo.':' · Chưa có tuyến đã định vị trong 30 km đường bộ.')};
}
